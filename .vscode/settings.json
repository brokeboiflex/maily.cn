{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.experimental.classRegex": [
    ["\\b\\w+[cC]lassName\\s*=\\s*[\"']([^\"']*)[\"']"],
    ["\\b\\w+[cC]lassName\\s*=\\s*`([^`]*)`"],
    ["[\\w]+[cC]lassName[\"']?\\s*:\\s*[\"']([^\"']*)[\"']"],
    ["[\\w]+[cC]lassName[\"']?\\s*:\\s*`([^`]*)`"],
    ["cva\\(((?:[^()]|\\([^()]*\\))*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(((?:[^()]|\\([^()]*\\))*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cn\\(((?:[^()]|\\([^()]*\\))*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "i18n-ally.localesPaths": [
    "packages/core/src/editor/i18n",
    "playground/src/components/maily/editor/i18n",
    "registry/default/maily/components/maily/editor/i18n"
  ]
}

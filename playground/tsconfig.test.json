{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  // Vitest unit tests, which the app build excludes. Owning them here keeps
  // their transform on playground settings instead of the repo root tsconfig.
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": []
}

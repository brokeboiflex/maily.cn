{
  "name": "@maily-to/render",
  "version": "0.2.3",
  "type": "module",
  "private": false,
  "description": "A transformer that converts Maily content into HTML email templates.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "build": "tsdown",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16 && node ../../scripts/check-package-entries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/render"
  },
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "keywords": [
    "maily.to",
    "react",
    "email"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@maily-to/shared": "workspace:*",
    "@types/react": "^19.3.0",
    "tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "csstype": "^3.2.3",
    "juice": "^12.2.0",
    "node-html-parser": "^9.0.5",
    "react-email": "^6.11.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

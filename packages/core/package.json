{
  "name": "@maily-to/core",
  "type": "module",
  "version": "0.3.7",
  "description": "Powerful editor for creating beautiful, pre-designed, mobile-ready emails.",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./blocks": {
      "import": {
        "types": "./dist/blocks/index.d.ts",
        "default": "./dist/blocks/index.mjs"
      },
      "require": {
        "types": "./dist/blocks/index.d.cts",
        "default": "./dist/blocks/index.cjs"
      }
    },
    "./extensions": {
      "import": {
        "types": "./dist/extensions/index.d.ts",
        "default": "./dist/extensions/index.mjs"
      },
      "require": {
        "types": "./dist/extensions/index.d.cts",
        "default": "./dist/extensions/index.cjs"
      }
    },
    "./mailbox": {
      "import": {
        "types": "./dist/mailbox/index.d.ts",
        "default": "./dist/mailbox/index.mjs"
      },
      "require": {
        "types": "./dist/mailbox/index.d.cts",
        "default": "./dist/mailbox/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "blocks": [
        "dist/blocks/index.d.ts"
      ],
      "extensions": [
        "dist/extensions/index.d.ts"
      ],
      "mailbox": [
        "dist/mailbox/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16 && node ../../scripts/check-package-entries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/core"
  },
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "keywords": [
    "tiptap",
    "wysiwyg",
    "maily.to",
    "editor",
    "react",
    "email"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "fast-deep-equal": "^3.1.3",
    "lucide-react": "^1.61.0",
    "react-colorful": "^5.8.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.31",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@maily-to/shared",
  "version": "0.0.2",
  "type": "module",
  "private": false,
  "description": "Shared utilities for Maily",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile node16 && node ../../scripts/check-package-entries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/maily.to.git",
    "directory": "packages/shared"
  },
  "author": "Arik Chakma <arikchangma@gmail.com>",
  "keywords": [
    "maily.to",
    "react",
    "email"
  ],
  "devDependencies": {
    "tsconfig": "workspace:*",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

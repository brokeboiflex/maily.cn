{
  "name": "maily",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "lint": "pnpm shadcn:audit && eslint .",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "shadcn:audit": "node scripts/audit-shadcn-primitives.mjs",
    "registry:build": "node scripts/build-shadcn-registry.mjs && pnpm shadcn:audit",
    "playground:sync": "pnpm registry:build && pnpm dlx shadcn@4.22.1 build registry.json --output playground/public/r",
    "registry:consumer-test": "pnpm playground:sync && node scripts/test-shadcn-consumers.mjs",
    "typecheck": "turbo run typecheck",
    "lint:package": "turbo run lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "tsconfig": "workspace:*",
    "tsdown": "^0.23.2",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
